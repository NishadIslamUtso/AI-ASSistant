diff --git a/apps/01_claude-exact-pixel-clone/scripts/shot.mjs b/apps/01_claude-exact-pixel-clone/scripts/shot.mjs
new file mode 100644
index 0000000..0030cb5
--- /dev/null
+++ b/apps/01_claude-exact-pixel-clone/scripts/shot.mjs
@@ -0,0 +1,77 @@
+/**
+ * Screenshot the running app so it can be compared against the user's real
+ * Claude screenshots. Usage:  node scripts/shot.mjs <name> [actions]
+ *
+ * Actions (comma separated):
+ *   settings   open the Settings modal
+ *   apps       open Apps & extensions
+ *   user       open the user menu
+ *   file       open the File menu
+ *   ctx        open the chat context menu
+ *   vault      open the vault panel
+ *   today      open the Today view
+ *   chat       click the first chat, type and send a message
+ *   artifact   ask the mock model for a game (artifact panel)
+ *   newchat    click New
+ */
+import { chromium } from 'playwright'
+import fs from 'fs'
+
+const name = process.argv[2] || 'app'
+const actions = (process.argv[3] || '').split(',').filter(Boolean)
+const OUT = process.env.SHOT_DIR || '/home/user/shots'
+fs.mkdirSync(OUT, { recursive: true })
+
+const browser = await chromium.launch({ args: ['--no-sandbox', '--disable-dev-shm-usage'] })
+const page = await browser.newPage({ viewport: { width: 1280, height: 680 }, deviceScaleFactor: 1.5 })
+const errors = []
+page.on('console', (m) => { if (m.type() === 'error') errors.push(m.text()) })
+page.on('pageerror', (e) => errors.push('PAGEERROR: ' + e.message))
+
+await page.addInitScript(() => {
+  try {
+    localStorage.setItem('claude_exact_chats_v2', 'reset')
+  } catch {}
+})
+await page.goto('http://127.0.0.1:5173/', { waitUntil: 'load' })
+await page.evaluate(() => { localStorage.removeItem('claude_exact_chats_v2') })
+await page.reload({ waitUntil: 'load' })
+await page.waitForTimeout(900)
+
+for (const a of actions) {
+  if (a === 'settings') { await page.evaluate(() => {}) } // handled below
+}
+
+if (actions.includes('user')) {
+  await page.click('button[title="nishadislamutso@gmail.com"]')
+} else if (actions.includes('file')) {
+  await page.click('button[title="File  Edit  View  Go  Help"]')
+} else if (actions.includes('ctx')) {
+  // 191646 right-clicks the chat row at device y=918 (the last fully visible one)
+  await page.mouse.click(100, 612, { button: 'right' })
+} else if (actions.includes('vault')) {
+  await page.click('button[title="AI-Brain vault"]')
+} else if (actions.includes('apps')) {
+  await page.click('button[title="nishadislamutso@gmail.com"]')
+  await page.click('text=Get apps and extensions')
+} else if (actions.includes('settings')) {
+  await page.click('button[title="nishadislamutso@gmail.com"]')
+  await page.click('text=Settings')
+} else if (actions.includes('today')) {
+  await page.click('button[title="AI-Brain vault"]')
+  await page.click('text=Open Today view')
+} else if (actions.includes('chat') || actions.includes('artifact')) {
+  await page.click('text=Refining a 5-day workout cycle')
+  await page.waitForTimeout(300)
+  const box = page.locator('textarea').first()
+  await box.click()
+  await box.fill(actions.includes('artifact') ? 'build me a tic tac toe game' : 'hello, who are you?')
+  await page.keyboard.press('Enter')
+  await page.waitForTimeout(actions.includes('artifact') ? 6000 : 4000)
+}
+
+await page.waitForTimeout(700)
+await page.screenshot({ path: `${OUT}/${name}.png` })
+console.log(`saved ${OUT}/${name}.png`)
+console.log('ERRORS:', JSON.stringify(errors, null, 1))
+await browser.close()
diff --git a/apps/01_claude-exact-pixel-clone/server/mock-ollama.cjs b/apps/01_claude-exact-pixel-clone/server/mock-ollama.cjs
new file mode 100644
index 0000000..0a0236d
--- /dev/null
+++ b/apps/01_claude-exact-pixel-clone/server/mock-ollama.cjs
@@ -0,0 +1,108 @@
+/**
+ * mock-ollama.cjs — Ollama-compatible stub for sandboxes / demos ONLY.
+ *
+ * It exists so the UI can be exercised (and screenshotted) on a machine that
+ * has no Ollama and no GPU. It implements just enough of the Ollama HTTP API:
+ *   GET  /api/tags
+ *   POST /api/chat   (NDJSON streaming)
+ *
+ * It is NEVER used by start-app.bat — the real build always talks to the real
+ * Ollama on 127.0.0.1:11434. Start it manually with `npm run dev:mock`.
+ */
+const http = require('http')
+
+const PORT = process.env.MOCK_PORT ? Number(process.env.MOCK_PORT) : 11434
+
+const MODELS = [
+  { name: 'qwen2.5:3b', model: 'qwen2.5:3b', size: 1900000000,
+    details: { family: 'qwen2', parameter_size: '3B', quantization_level: 'Q4_K_M' } },
+  { name: 'qwen3-vl:4b', model: 'qwen3-vl:4b', size: 2900000000,
+    details: { family: 'qwen3', parameter_size: '4B', quantization_level: 'Q4_K_M' } },
+]
+
+function replyFor(prompt) {
+  const p = String(prompt || '')
+  const last = p.split('\n').filter((l) => l.trim()).slice(-1)[0] || ''
+  return [
+    `**(demo reply — mock Ollama, no model loaded)**`,
+    ``,
+    `You said: “${last.slice(0, 200)}”`,
+    ``,
+    `- This response comes from \`server/mock-ollama.cjs\`, not from qwen2.5:3b.`,
+    `- On your TUF A15, \`start-app.bat\` starts the **real** Ollama and this app streams from \`127.0.0.1:11434\`.`,
+    `- The vault API (\`127.0.0.1:8765\`) writes into \`vault/AI-Brain/\` as Markdown.`,
+    ``,
+    `Ask for “build me a tic-tac-toe game” and the reply will include an \`artifact:html\` block that opens in the Artifacts panel.`,
+  ].join('\n')
+}
+
+const server = http.createServer((req, res) => {
+  res.setHeader('Access-Control-Allow-Origin', '*')
+  res.setHeader('Access-Control-Allow-Headers', '*')
+  res.setHeader('Access-Control-Allow-Methods', 'GET,POST,OPTIONS')
+  if (req.method === 'OPTIONS') { res.writeHead(204); return res.end() }
+
+  if (req.url.startsWith('/api/tags')) {
+    res.writeHead(200, { 'Content-Type': 'application/json' })
+    return res.end(JSON.stringify({ models: MODELS }))
+  }
+
+  if (req.url.startsWith('/api/chat')) {
+    let body = ''
+    req.on('data', (c) => (body += c))
+    req.on('end', async () => {
+      let payload = {}
+      try { payload = JSON.parse(body || '{}') } catch {}
+      const msgs = payload.messages || []
+      const prompt = (msgs.find((m) => m.role === 'user') || {}).content || ''
+      const text = /tic|tac|toe|game|snake|flappy/i.test(prompt)
+        ? ARTIFACT_DEMO
+        : replyFor(prompt)
+
+      res.writeHead(200, { 'Content-Type': 'application/x-ndjson' })
+      const chunks = text.match(/[\s\S]{1,7}/g) || []
+      for (const c of chunks) {
+        res.write(JSON.stringify({ model: payload.model || MODELS[0].name, created_at: new Date().toISOString(), message: { role: 'assistant', content: c }, done: false }) + '\n')
+        await new Promise((r) => setTimeout(r, 12))
+      }
+      res.write(JSON.stringify({ model: payload.model || MODELS[0].name, created_at: new Date().toISOString(), message: { role: 'assistant', content: '' }, done: true, done_reason: 'stop' }) + '\n')
+      res.end()
+    })
+    return
+  }
+
+  if (req.url === '/' || req.url === '/api/version') {
+    res.writeHead(200, { 'Content-Type': 'application/json' })
+    return res.end(JSON.stringify({ version: '0.0.0-mock' }))
+  }
+
+  res.writeHead(404); res.end('not found')
+})
+
+const ARTIFACT_DEMO = `Here you go — a runnable artifact:
+
+\`\`\`artifact:html
+<!DOCTYPE html>
+<html><head><meta charset="utf-8"><title>Tic Tac Toe</title>
+<style>
+ body{font-family:system-ui;display:grid;place-items:center;height:100vh;margin:0;background:#faf9f7}
+ .b{display:grid;grid-template-columns:repeat(3,90px);gap:6px}
+ button{width:90px;height:90px;font-size:34px;background:#fff;border:1px solid #ddd;border-radius:10px;cursor:pointer}
+ h1{font-size:20px;margin:0 0 14px}
