+
+export default function SettingsModal({ section, onSection, onClose, models, model, onModel, onOpenApps }) {
+  const s = settings.get()
+  const set = (patch) => { settings.set(patch); window.dispatchEvent(new Event('settings-changed')) }
+
+  return (
