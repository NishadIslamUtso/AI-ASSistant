{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd apps/03_ai-assistant && npm install --ignore-scripts",
  "buildCommand": "cd apps/03_ai-assistant && npm run build:web",
  "outputDirectory": "apps/03_ai-assistant/dist-web",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
