{
  "manifest_version": 3,
  "name": "AI ASSistant - Vault Collector",
  "version": "0.1.1",
  "description": "Local-only collector + context suggester. AI sites by default, optional broad capture. Capsule Hub + Quillbot style.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "optional_permissions": ["history"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://chat.deepseek.com/*",
    "https://www.deepseek.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["lib/blacklist.js", "lib/capsule.js", "lib/vault-writer.js", "content-scripts/ai-capture.js", "content-scripts/capsule-inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["lib/blacklist.js", "lib/vault-writer.js", "content-scripts/generic-capture.js", "content-scripts/quillbot-suggestions.js", "content-scripts/capsule-inject.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI ASSistant Vault"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
